#!/usr/bin/env python3

import os
import ROOT
import glob
import zfit
import numpy
import argparse
import zutils.utils      as zut
import matplotlib.pyplot as plt
import utils_noroot      as utnr

from importlib.resources import files
from zutils.plot         import plot       as zfp
from fitter              import zfitter
from hqm2.signal         import get_signal
from log_store           import log_store

log=log_store.add_logger('hqm2:fit_mc')
#------------------------------
class data:
    l_dset = ['r1', 'r2p1', '2017', '2018']
    l_trig = ['MTOS', 'ETOS']
    log_lvl= 20
    ntries = 10
    mc_vers= 'v1'
    plt_dir= 'plots/fit'

    d_lum  = {
            '2011' : 1.0, 
            '2012' : 2.0, 
            '2015' : 0.3, 
            '2016' : 1.6, 
            '2017' : 1.7, 
            '2018' : 2.1}

    obs_ee = zfit.Space("B_M", limits=(4500, 6000))
    obs_mm = zfit.Space("B_M", limits=(5180, 5800))
#------------------------------
def get_args():
    parser = argparse.ArgumentParser(description='Used to fit simulated MC in rare mode after full selection')
    parser.add_argument('-d', '--dset' , nargs='+', help='Year, default: {data.l_dset}'   , default=data.l_dset, choices=data.l_dset)
    parser.add_argument('-t', '--trig' , nargs='+', help='Trigger, default: {data.l_trig}', default=data.l_trig, choices=data.l_trig)
    parser.add_argument('-l', '--logl' , type =int, help='Log level, default: {data.log_lvl}', default=data.log_lvl, choices=[10,20,30,40])
    parser.add_argument('-n', '--ntry' , type =int, help='Number of tries, default: {data.ntries}', default=data.ntries) 
    args = parser.parse_args()

    data.l_dset = args.dset
    data.l_trig = args.trig
    data.log_lvl= args.logl
    data.ntries = args.ntry
#------------------------------
def get_dat(dset, trig, brem):
    log.debug(f'Getting data for: {dset}/{trig}')
    if   dset == 'r1': 
        arr_11 = get_dat_by_year('2011', trig, brem)
        arr_12 = get_dat_by_year('2012', trig, brem)

        arr_dat, arr_wgt = merge_years(arr_11, arr_12)
    elif dset == 'r2p1': 
        arr_15 = get_dat_by_year('2015', trig, brem)
        arr_16 = get_dat_by_year('2016', trig, brem)

        arr_dat, arr_wgt = merge_years(arr_15, arr_16)
    else:
        arr_dat= get_dat_by_year(dset, trig, brem)
        arr_wgt= numpy.ones_like(arr_dat)

    obs = {'ETOS' : data.obs_ee, 'MTOS' : data.obs_mm}[trig]
    dat = zfit.Data.from_numpy(array=arr_dat, weights=arr_wgt, obs=obs)

    return dat 
#------------------------------
def merge_years(arr_dat_y1, arr_dat_y2):
    y1 = arr_dat_y1.year
    y2 = arr_dat_y2.year

    l1 = data.d_lum[y1]
    l2 = data.d_lum[y2]

    arr_wgt_y1 = numpy.full(arr_dat_y1.shape, l1)
    arr_wgt_y2 = numpy.full(arr_dat_y2.shape, l2)

    arr_dat = numpy.concatenate([arr_dat_y1, arr_dat_y2])
    arr_wgt = numpy.concatenate([arr_wgt_y1, arr_wgt_y2])

    return arr_dat, arr_wgt
#------------------------------
def get_dat_by_year(year, trig, brem):
    log.debug(f'Getting data for: {year}/{trig}/{brem}')

    asl_dir = os.environ['ASLDIR']
    rdf_wc  = f'{asl_dir}/rare_mc_fit/{data.mc_vers}/sign/v10.21p2/{year}_{trig}/*.root'
    l_path  = glob.glob(rdf_wc)
    nfile   = len(l_path)
    if nfile == 0:
        log.error(f'No file found in: {rdf_wc}')
        raise

    rdf      = ROOT.RDataFrame(trig, l_path)
    if trig != 'MTOS':
        rdf      = rdf.Define('nbrem', 'L1_BremMultiplicity + L2_BremMultiplicity')
        rdf      = rdf.Define('xbrem', 'nbrem >= 2 ? 2 : nbrem')
        rdf      = rdf.Filter(f'xbrem == {brem}', 'BREM')
        rep      = rdf.Report()
        rep.Print()

    arr_mass = rdf.AsNumpy(['B_M'])['B_M']

    arr_mass.year = year

    return arr_mass
#------------------------------
def get_pdf(dset, trig):
    log.debug(f'Getting PDF for: {dset}/{trig}')
    obs   = {'ETOS' : data.obs_ee, 'MTOS' : data.obs_mm}[trig]
    pdf   = get_signal(obs=obs, dset=dset, trig=trig, prefix=f'mc_fit_{dset}_{trig}', syst='nom')
    s_par = pdf.get_params()

    for par in s_par:
        #For MC fit, scales are 0 and fixed
        if par.name.startswith('sc_'):
            par.set_value(0)
            par.floating=False

        #For MC fit, resolutions are 1 and fixed
        if par.name.startswith('rs_'):
            par.set_value(1)
            par.floating=False

    if trig == 'MTOS':
        epdf_z = _extend_pdf(pdf, dset, trig, '0')

        return [epdf_z]

    [pdf_z, pdf_o, pdf_t] = pdf.models

    epdf_z = _extend_pdf(pdf_z, dset, trig, '0')
    epdf_o = _extend_pdf(pdf_o, dset, trig, '1')
    epdf_t = _extend_pdf(pdf_t, dset, trig, '2')

    return [epdf_z, epdf_o, epdf_t]
#------------------------------
def _extend_pdf(pdf, dset, trig, brem):
    nevt     = zfit.param.Parameter(f'nevt_{dset}_{trig}_brem_{brem}', 0, 0, 1e7)
    pdf      = pdf.create_extended(nevt)
    pdf.brem = brem

    return pdf
#------------------------------
def fit(pdf, dat):
    obj=zfitter(pdf, dat)
    res=obj.fit(ntries=data.ntries, pval_threshold=0.05)
    print(res)

    return res
#------------------------------
def plot_fit(pdf, dat, res, dset, trig):
    obj=zfp(model=pdf, data=dat, result=res) 
    obj.plot()
    plot_path = f'{data.plt_dir}/{dset}_{trig}_{pdf.brem}.png'
    log.info(f'Saving to: {plot_path}')
    plt.savefig(plot_path)
    plt.close('all')
#------------------------------
def save_pars(l_res, dset, trig):
    d_par = dict()
    for res in l_res:
        d_tmp = { par.name : d_val['value'] for par, d_val in res.params.items() }
        d_par.update(d_tmp)

    par_path = files('hqm2_data').joinpath(f'mc_pars/{dset}_{trig}.json')

    log.info(f'Saving to: {par_path}')
    utnr.dump_json(d_par, par_path)
#------------------------------
def main():
    get_args()

    os.makedirs(data.plt_dir, exist_ok=True)
    log.setLevel(data.log_lvl)

    for dset in data.l_dset:
        for trig in data.l_trig:
            log.info(f'Fitting for: {dset}/{trig}')
            l_pdf = get_pdf(dset, trig)
            l_dat = [ get_dat(dset, trig, pdf.brem) for pdf in l_pdf ]
            l_res = [ fit(pdf, dat) for pdf, dat in zip(l_pdf, l_dat) ]

            for pdf, dat, res in zip(l_pdf, l_dat, l_res):
                plot_fit(pdf, dat, res, dset, trig)

            save_pars(l_res, dset, trig)
#------------------------------
if __name__ == '__main__':
    main()

