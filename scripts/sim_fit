#!/usr/bin/env python3

import os
import ROOT
import zfit
import toml
import pprint
import mplhep
import argparse
import matplotlib.pyplot as plt

from hqm2.data_store     import data_store
from hqm2.config         import config
from hqm2.ratc           import ratc 
from log_store           import log_store
from importlib.resources import files

log=log_store.add_logger('rx_hqm2:sim_fit')
#-----------------------------------
class data:
    dset = None
    var  = None 
    ibin = None

    l_dset = ['r1', 'r2p1', '2017', '2018']
#-----------------------------------
def get_args():
    parser = argparse.ArgumentParser(description='Used to do simultaneous fits in a bin of a specific variable')
    parser.add_argument('-d', '--dset', type=str, help='Dataset', required=True, choices=data.l_dset)
    parser.add_argument('-v', '--var' , type=str, help='Variable', required=True)
    parser.add_argument('-b', '--ibin', type=str, help='Bin index')
    args = parser.parse_args()

    data.dset = args.dset
    data.var  = args.var
    data.ibin = args.ibin
#-----------------------------------
def set_config():
    config_path  = files('hqm2_data').joinpath('config/sim_fit.toml')
    d_config     = toml.load(config_path)

    config.fitting['ntries'        ] = d_config['fits']['ntries']
    config.fitting['pval_threshold'] = d_config['fits']['pval_threshold']
    config.print_config('fitting')

    if data.var == 'none':
        return

    [minv, maxv] = d_config[data.var][data.ibin]

    config.binning['bin'           ] = data.ibin
    config.binning['var'           ] = data.var
    config.binning['cut'           ] = f'({minv} < {data.var}) && ({data.var} < {maxv})'
    config.print_config('binning')
#-----------------------------------
def set_logs():
    log_store.set_level('scripts:zutils/utils'    , 30)
    log_store.set_level('rx_hqm2:data_store'      , 30)
    log_store.set_level('rx_scripts:storage/cache', 30)
    log_store.set_level('rx_scripts:atr_mgr:mgr'  , 30)
    log_store.set_level('tools:calc_utility'      , 40)
#-----------------------------------
def set_env():
    os.environ['MKL_NUM_THREADS']      = '1'
    os.environ['NUMEXPR_NUM_THREADS']  = '1'
    os.environ['OMP_NUM_THREADS']      = '1'
    os.environ['OPENBLAS_NUM_THREADS'] = '1'
#-----------------------------------
def main():
    get_args()
    set_config()
    set_logs()
    set_env()

    plt.style.use(mplhep.style.LHCb2)

    obs=zfit.Space('B_M', limits=(0, 7000))
    obj=ratc(obs=obs, dset=data.dset)
    rat=obj.get_ratio()
#-----------------------------------
if __name__ == '__main__':
    main()

