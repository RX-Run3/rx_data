#!/usr/bin/env python3

import pandas       as pnd
import utils_noroot as utnr

from importlib.resources import files

#-----------------------------------
class data:
    table_path = None
    l_dset     = ['r1', 'r2p1', '2017', '2018']
    kind       = 'int'
    pars_dir   = files('hqm2_data').joinpath(f'ratios/{kind}')
#-----------------------------------
def get_ratio(dset=None, kind=None):
    pars_path = f'{data.pars_dir}/{dset}/parameters.json'
    d_data    = utnr.load_json(pars_path)
    [val, err]= d_data[f'rat_{kind}']
    ratio     = f'{val:.3f}$\pm${err:.3f}'

    return ratio
#-----------------------------------
def get_ratios():
    d_data = {'Dataset' : [], '$r_{\psi(2S)}$' : [], '$r_{J/\psi}$' : []}
    for dset in data.l_dset:
        valp = get_ratio(dset=dset, kind='psi2')
        valj = get_ratio(dset=dset, kind='ctrl')

        d_data['Dataset'       ].append(dset)
        d_data['$r_{\psi(2S)}$'].append(valp)
        d_data['$r_{J/\psi}$'  ].append(valj)

    df = pnd.DataFrame(d_data)

    return df
#-----------------------------------
def main():
    df = get_ratios()
    table_path = f'{data.pars_dir}/ratios.tex'
    df.to_latex(table_path, index=False)
#-----------------------------------
if __name__ == '__main__':
    main()

