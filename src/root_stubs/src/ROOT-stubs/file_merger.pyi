from typing import Any

class TFileMerger:
    # Merge-type flags for PartialMerge (values left to ROOT at runtime)
    kRegular: int
    kAll: int
    kIncremental: int
    kResetable: int
    kNonResetable: int
    kOnlyListed: int
    kSkipListed: int
    kKeepCompression: int

    def __init__(self, isLocal: bool = ..., histoOneGo: bool = ...) -> None: ...

    # Inputs / output
    def AddFile(self, source: Any, cpProgress: bool = ...) -> bool: ...
    def AddFile(self, source: Any, cpProgress: bool, *args: Any) -> bool: ...  # type: ignore[no-redef]
    def AddObjectNames(self, names: str) -> None: ...
    def OutputFile(self, outputfile: str, *args: Any) -> bool: ...
    def GetOutputFileName(self) -> str: ...
    def PrintFiles(self, options: str = ...) -> None: ...
    def Reset(self) -> None: ...

    # Merging
    def Merge(self, dirty: bool = ...) -> bool: ...
    def PartialMerge(self, type: int = ...) -> bool: ...

    # Options
    def SetMaxOpenedFiles(self, newmax: int) -> None: ...
    def SetPrintLevel(self, level: int) -> None: ...
    def SetNotrees(self, flag: bool) -> None: ...
    def SetFastMethod(self, flag: bool) -> None: ...
    def SetMsgPrefix(self, prefix: str) -> None: ...
    def GetMsgPrefix(self) -> str: ...
