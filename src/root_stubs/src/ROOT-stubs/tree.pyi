"""Minimal type stub for ROOT.TTree (PyROOT)."""

from typing import Any, Iterator, Optional, Union, overload

class TObject:
    def Write(self, name: str = ..., option: int = ..., bufsize: int = ...) -> int: ...
    def Draw(self, option: str = ...) -> None: ...
    def Print(self, option: str = ...) -> None: ...
    def Clone(self, newname: str = ...) -> "TObject": ...

class TNamed(TObject):
    def GetName(self) -> str: ...
    def GetTitle(self) -> str: ...
    def SetName(self, name: str) -> None: ...
    def SetTitle(self, title: str = ...) -> None: ...

class TDirectory(TNamed):
    def cd(self) -> bool: ...
    def Get(self, namecycle: str) -> Any: ...

class TFile(TDirectory):
    def __init__(self, fname: str, option: str = ..., ftitle: str = ..., compress: int = ...) -> None: ...
    @staticmethod
    def Open(name: str, option: str = ..., ftitle: str = ..., compress: int = ...) -> "TFile": ...
    def Close(self, option: str = ...) -> None: ...
    def IsOpen(self) -> bool: ...
    def IsZombie(self) -> bool: ...

class TBranch(TNamed):
    def GetEntries(self) -> int: ...
    def GetEntry(self, entry: int = ..., getall: int = ...) -> int: ...
    def GetLeaf(self, name: str) -> "TLeaf": ...

class TLeaf(TNamed):
    def GetValue(self, i: int = ...) -> float: ...
    def GetTypeName(self) -> str: ...

class TCut(TNamed):
    def __init__(self, title: str = ...) -> None: ...

class TEventList(TNamed): ...
class TEntryList(TNamed): ...
class TList(TObject):
    def __iter__(self) -> Iterator[Any]: ...
    def GetEntries(self) -> int: ...

class TTreeFormula(TNamed): ...
class TVirtualTreePlayer: ...

# --- TTree ----------------------------------------------------------------

class TTree(TNamed):
    # Construction
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, name: str, title: str, splitlevel: int = ..., dir: Optional[TDirectory] = ...) -> None: ...

    # Filling / entries
    def Fill(self) -> int: ...
    def GetEntries(self, selection: str = ...) -> int: ...
    def GetEntry(self, entry: int, getall: int = ...) -> int: ...
    def GetEntriesFast(self) -> int: ...
    def LoadTree(self, entry: int) -> int: ...
    def GetReadEntry(self) -> int: ...
    def GetEvent(self, entry: int = ..., getall: int = ...) -> int: ...
    def __iter__(self) -> Iterator["TTree"]: ...
    def __len__(self) -> int: ...
    def __getattr__(self, name: str) -> Any: ...  # branch access, e.g. tree.x

    # Branches / leaves
    @overload
    def Branch(self, name: str, address: Any, leaflist: str, bufsize: int = ...) -> TBranch: ...
    @overload
    def Branch(self, name: str, address: Any, bufsize: int = ..., splitlevel: int = ...) -> TBranch: ...
    @overload
    def Branch(self, name: str, classname: str, addobj: Any, bufsize: int = ..., splitlevel: int = ...) -> TBranch: ...
    def GetBranch(self, name: str) -> TBranch: ...
    def GetListOfBranches(self) -> TList: ...
    def GetLeaf(self, name: str) -> TLeaf: ...
    def GetListOfLeaves(self) -> TList: ...
    def GetNbranches(self) -> int: ...
    def SetBranchAddress(self, bname: str, add: Any, ptr: Any = ...) -> int: ...
    def SetBranchStatus(self, bname: str, status: bool = ..., found: Any = ...) -> None: ...
    def GetBranchStatus(self, branchname: str) -> bool: ...
    def ResetBranchAddresses(self) -> None: ...

    # Drawing / querying
    def Project(self, hname: str, varexp: str, selection: Union[str, TCut] = ..., option: str = ..., nentries: int = ..., firstentry: int = ...) -> int: ...
    def Scan(self, varexp: str = ..., selection: Union[str, TCut] = ..., option: str = ..., nentries: int = ..., firstentry: int = ...) -> int: ...
    def Query(self, varexp: str = ..., selection: Union[str, TCut] = ..., option: str = ..., nentries: int = ..., firstentry: int = ...) -> Any: ...
    def GetV1(self) -> Any: ...
    def GetV2(self) -> Any: ...
    def GetSelectedRows(self) -> int: ...
    def SetAlias(self, aliasName: str, aliasFormula: str) -> bool: ...
    def GetAlias(self, aliasName: str) -> str: ...

    # Selection / lists
    def SetEventList(self, evlist: Optional[TEventList]) -> None: ...
    def SetEntryList(self, elist: Optional[TEntryList], opt: str = ...) -> None: ...
    def GetEntryList(self) -> TEntryList: ...
    def SetEstimate(self, nentries: int = ...) -> None: ...

    # Friends / chains / structure
    def AddFriend(self, treename: str, filename: str = ...) -> TTree: ...
    def AddFriend(self, tree: "TTree", alias: str = ...) -> TTree: ...  # type: ignore[no-redef]
    def BuildIndex(self, majorname: str, minorname: str = ...) -> int: ...
    def CloneTree(self, nentries: int = ..., option: str = ...) -> "TTree": ...
    def CopyEntries(self, tree: "TTree", nentries: int = ..., option: str = ...) -> int: ...
    def CopyTree(self, selection: str, option: str = ..., nentries: int = ..., firstentry: int = ...) -> "TTree": ...
    def Merge(self, li: TList, option: str = ...) -> int: ...
    def GetFriend(self, name: str) -> "TTree": ...

    # I/O / housekeeping
    def Write(self, name: str = ..., option: int = ..., bufsize: int = ...) -> int: ...
    def AutoSave(self, option: str = ...) -> int: ...
    def FlushBaskets(self) -> int: ...
    def Reset(self, option: str = ...) -> None: ...
    def SetDirectory(self, dir: Optional[TDirectory]) -> None: ...
    def GetDirectory(self) -> TDirectory: ...
    def GetCurrentFile(self) -> TFile: ...
    def GetTotBytes(self) -> int: ...
    def GetZipBytes(self) -> int: ...
    def SetMaxTreeSize(self, maxsize: int = ...) -> None: ...
    def SetAutoSave(self, autos: int = ...) -> None: ...
    def SetAutoFlush(self, autof: int = ...) -> None: ...
    def SetCacheSize(self, cachesize: int = ...) -> int: ...
    def SetCircular(self, maxEntries: int) -> None: ...
    def SetBasketSize(self, bname: str, buffsize: int = ...) -> None: ...
    def SetWeight(self, w: float = ..., option: str = ...) -> None: ...
    def GetWeight(self) -> float: ...

    # Code generation
    def MakeClass(self, classname: str = ..., option: str = ...) -> int: ...
    def MakeSelector(self, selector: str = ..., option: str = ...) -> int: ...
    def MakeCode(self, filename: str = ...) -> int: ...
    def MakeProxy(self, classname: str, macrofilename: str = ..., cutfilename: str = ..., option: str = ..., maxUnrolling: int = ...) -> int: ...
    def Process(self, selector: Any, option: str = ..., nentries: int = ..., firstentry: int = ...) -> int: ...

    # Introspection
    def Print(self, option: str = ...) -> None: ...
    def Show(self, entry: int = ..., lenmax: int = ...) -> None: ...
    def Refresh(self) -> None: ...
