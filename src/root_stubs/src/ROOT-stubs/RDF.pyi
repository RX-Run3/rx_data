import numpy
import pandas as pnd

from typing           import Iterator
from typing           import Self, overload
from ROOT             import TCutInfo
from dask.distributed import Client

class RResultPtr:
    def GetValue(self) -> int: ...

class RCutFlowReport:
    def Print(self) -> None: ...
    def begin(self) -> TCutInfo: ...
    def end(self)   -> TCutInfo: ...
    def __iter__(self) -> Iterator[TCutInfo]: ...

class RSnapshotOptions:
    def __init__(self) -> None:
        self.fMode              : str
        self.fOverwriteIfExists : bool

class RDisplay:
    def Print(self) -> None: ...

class String:
    def c_str(self) -> str: ...

class RNode:
    def Define(self, name: str, definition: str) -> Self: ...
    def DefinePerSample(self, name: str, definition: str) -> Self: ...
    def Redefine(self, name: str, definition: str) -> Self: ...
    def Count(self) -> RResultPtr: ...
    def GetColumnNames(self) -> list[String]: ...
    def Range(self, end : int, begin : int = 0) -> 'RNode': ...
    def Report(self) -> RCutFlowReport: ...
    def Display(self, columnListRegexp : str = '', nRows : int = 5, nMaxCollectionElements : int = 10) -> RDisplay: ...
    # ------------------
    @property
    def uid(self) -> str: ...
    # ------------------
    @overload
    def Snapshot(self, treename : str, filename : str                                                 ) -> RNode: ...
    @overload
    def Snapshot(self, treename : str, filename : str, columns : list[str]                            ) -> RNode: ...
    @overload
    def Snapshot(self, treename : str, filename : str,                      options : RSnapshotOptions) -> RNode: ...
    @overload
    def Snapshot(self, treename : str, filename : str, columns : list[str], options : RSnapshotOptions) -> RNode: ...
    # ------------------
    @overload
    def Filter(self, expression : str) -> 'RNode': ...
    @overload
    def Filter(self, expression : str, name : str) -> 'RNode': ...
    # ------------------
    def AsNumpy(self, columns : list[str] = []) -> dict[str, numpy.ndarray]: ...
    # ------------------
    def Sum(self, column : str) -> RResultPtr: ...

class Experimental:
    @staticmethod
    def FromSpec(jsonFile : str, executor : Client | None = None) -> RNode: ...

def FromNumpy(data : dict[str,numpy.ndarray]) -> RNode: ...
def FromPandas(df : pnd.DataFrame) -> RNode: ...
