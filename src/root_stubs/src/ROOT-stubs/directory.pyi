from types import Any

class TUUID:
    def AsString(self) -> str: ...

class TFile:
    def __init__(self, name: str, option: str = ..., ftitle: str = ..., compress: int = ...) -> None: ...
    @staticmethod
    def Open(name: str, option: str = ...) -> TFile | None: ...
    def Get(self, namecycle: str) -> Any: ...
    def GetUUID(self) -> TUUID: ...
    def Close(self, option: str = ...) -> None: ...
    def Write(self, name: str = ..., option: int = ..., bufsize: int = ...) -> int: ...
    def IsOpen(self) -> bool: ...
    def IsZombie(self) -> bool: ...
    def ls(self) -> None: ...
    def GetName(self) -> str: ...
    def GetPath(self) -> str: ...
    def GetListOfKeys(self) -> Any: ...
    def cd(self, path: str = ...) -> bool: ...

class TDirectoryFile:
    def __init__(
        self,
        name: str = ...,
        title: str = ...,
        option: str = ...,
        mother_dir: Any = ...,
    ) -> None: ...

    def InheritsFrom(self, classname: str) -> bool: ...
    def GetName(self) -> str: ...
    def GetListOfKeys(self) -> Any: ...
    def Add(self, obj: Any, replace: bool = ...) -> None: ...
    def Append(self, obj: Any, replace: bool = ...) -> None: ...
    def AppendKey(self, key: Any) -> int: ...
    def Browse(self, browser: Any) -> None: ...
    def Build(
        self,
        mother_file: Any = ...,
        mother_dir: Any = ...,
    ) -> None: ...
    def CloneObject(self, obj: Any, autoadd: bool = ...) -> Any: ...
    def Copy(self, obj: Any) -> None: ...
    def Delete(self, namecycle: str = ...) -> None: ...
    def FillBuffer(self, buffer: Any) -> None: ...
    def FindKey(self, keyname: str) -> Any: ...
    def FindKeyAny(self, keyname: str) -> Any: ...
    def FindObjectAny(self, name: str) -> Any: ...
    def FindObjectAnyFile(self, name: str) -> Any: ...
    def GetBufferSize(self) -> int: ...
    def GetCreationDate(self) -> Any: ...
    def GetDirectory(
        self,
        path: str,
        print_error: bool = ...,
        funcname: str = ...,
    ) -> TDirectoryFile | None: ...
    def GetFile(self) -> TFile | None: ...
    def GetKey(self, name: str, cycle: int = ...) -> Any: ...
    def GetModificationDate(self) -> Any: ...
    def GetNbytesKeys(self) -> int: ...
    def GetNkeys(self) -> int: ...
    def GetObjectChecked(self, namecycle: str, classname: Any) -> Any: ...
    def GetObjectUnchecked(self, namecycle: str) -> Any: ...
    def GetSeekDir(self) -> int: ...
    def GetSeekKeys(self) -> int: ...
    def GetSeekParent(self) -> int: ...
    def IsA(self) -> Any: ...
    def IsModified(self) -> bool: ...
    def IsWritable(self) -> bool: ...
    def mkdir(
        self,
        name: str,
        title: str = ...,
        return_existing_directory: bool = ...,
    ) -> TDirectoryFile | None: ...
    def OpenFile(
        self,
        name: str,
        option: str = ...,
        ftitle: str = ...,
        compress: int = ...,
        netopt: int = ...,
    ) -> TFile | None: ...
    def Purge(self, nkeep: int = ...) -> None: ...
    def ReadAll(self, option: str = ...) -> None: ...
    def ReadKeys(self, force_read: bool = ...) -> int: ...
    def ReadTObject(self, obj: Any, keyname: str) -> int: ...
    def ResetAfterMerge(self, info: Any) -> None: ...
    def rmdir(self, name: str) -> None: ...
    def Save(self) -> None: ...
    def SaveObjectAs(
        self,
        obj: Any,
        filename: str = ...,
        option: str = ...,
    ) -> int: ...
    def SaveSelf(self, force: bool = ...) -> None: ...
    def SetBufferSize(self, bufsize: int) -> None: ...
    def SetModified(self) -> None: ...
    def SetSeekDir(self, value: int) -> None: ...
    def SetTRefAction(self, ref: Any, parent: Any) -> None: ...
    def SetWritable(self, writable: bool = ...) -> None: ...
    def Sizeof(self) -> int: ...
    def Streamer(self, buffer: Any) -> None: ...
    def StreamerNVirtual(self, buffer: Any) -> None: ...
    def WriteDirHeader(self) -> None: ...
    def WriteKeys(self) -> None: ...
    def WriteObjectAny(
        self,
        obj: Any,
        classname: Any,
        name: str,
        option: str = ...,
        bufsize: int = ...,
    ) -> int: ...
    def WriteTObject(
        self,
        obj: Any,
        name: str | None = ...,
        option: str = ...,
        bufsize: int = ...,
    ) -> int: ...
