class GVar:
    def __init__(self, *args, **kwargs) -> None: ...
    @property
    def mean(self) -> float: ...
    @property
    def sdev(self) -> float: ...
    def __add__(self, other: GVar | float) -> GVar: ...
    def __iadd__(self, other: GVar | float) -> GVar: ...
    def __sub__(self, other: GVar | float) -> GVar: ...
    def __mul__(self, other: GVar | float) -> GVar: ...
    def __truediv__(self, other: GVar | float) -> GVar: ...

def gvar(mean: float = ..., sdev: float = ...) -> GVar: ...
def sqrt(x: GVar) -> GVar: ...
