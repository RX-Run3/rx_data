#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: ${0##*/} FILE TREE" >&2
    echo "Interactively browse the branches of TREE in the ROOT file FILE." >&2
}

if [[ $# -ne 2 ]]; then
    usage
    exit 1
fi

file=$1
tree=$2

if [[ ! -r $file ]]; then
    echo "Error: cannot read file '$file'" >&2
    exit 1
fi

for cmd in python3 fzf; do
    command -v "$cmd" >/dev/null || { echo "Error: '$cmd' not found in PATH" >&2; exit 1; }
done

python3 - "$file" "$tree" <<'PY' | fzf --multi --delimiter=$'\t' --with-nth=1,2 \
                                      --prompt="branch> " | cut -f1
import sys

import uproot

path, tree_name = sys.argv[1:3]

try:
    with uproot.open(path) as f:
        if tree_name not in f:
            sys.exit(f"Error: tree '{tree_name}' not found in '{path}'")
        for name, typ in f[tree_name].typenames().items():
            print(f"{name}\t{typ}")
except Exception as e:
    sys.exit(f"Error: cannot open ROOT file '{path}': {e}")
PY
