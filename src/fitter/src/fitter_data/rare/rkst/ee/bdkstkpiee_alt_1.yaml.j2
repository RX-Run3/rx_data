component : bdkstkpiee
categories:
{% for block in range(1, 9) %}
  BREM_b{{ block }}:
    selection :
      block: block == {{ block }}
    model:
      pdfs :
        - cbl
        - cbr
      fix           : {}
      reparametrize :
        mu : scale
        sg : reso
      shared        :
        - mu
        - sg
      floating      : []
      values        :
        sg :
          -  50
          -  30
          - 100
{% endfor %}
fit:
  strategy  :
    pvalue : 0.05
    ntries : 10
plots:
  nbins   : 30
  stacked : True
  d_leg   :
{% for block in range(1, 9) %}
    cbl_bdkstkpiee_brem_xx1_b{{ block }}_1 : '$B^0\to K^{*0}(\to K^+\pi^-)e^+e^-$, $1\gamma$, Block {{ block }} (Left tail)'
    cbl_bdkstkpiee_brem_xx2_b{{ block }}_1 : '$B^0\to K^{*0}(\to K^+\pi^-)e^+e^-$, $2\gamma$, Block {{ block }} (Left tail)'
    cbr_bdkstkpiee_brem_xx1_b{{ block }}_1 : '$B^0\to K^{*0}(\to K^+\pi^-)e^+e^-$, $1\gamma$, Block {{ block }} (Right tail)'
    cbr_bdkstkpiee_brem_xx2_b{{ block }}_1 : '$B^0\to K^{*0}(\to K^+\pi^-)e^+e^-$, $2\gamma$, Block {{ block }} (Right tail)'
{% endfor %}
