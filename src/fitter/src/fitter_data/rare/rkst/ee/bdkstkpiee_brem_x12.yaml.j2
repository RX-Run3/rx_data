component : bdkstkpiee 
categories:
{% for block in range(1, 9) %}
  brem_xx1_b{{ block }}:
    selection : 
      block: block == {{ block }}
      brem : nbrem == 1 
    model:
      pdfs :
        - dscb
      fix           : {}
      reparametrize :
        mu : scale
        sg : reso 
      shared        :
        - mu
        - sg
      floating      : []
  brem_xx2_b{{ block }}:
    selection : 
      block: block == {{ block }}
      brem : nbrem == 2
    model:
      pdfs :
        - dscb
      fix           : {}
      reparametrize :
        mu : scale
        sg : reso 
      shared        :
        - mu
        - sg
      floating      : []
{% endfor %}
fit:
  strategy  :
    pvalue : 0.05
    ntries : 10
plots:
  nbins   : 30
  stacked : True
  d_leg   : {}
