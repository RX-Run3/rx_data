component : bpkpee
categories:
{% for block in range(1, 9) %}
  BREM_b{{ block }}:
    selection :
      block: block == {{ block }}
    model:
      pdfs :
        - dscb
      fix           : {}
      reparametrize :
        mu : scale
        sg : reso
      shared        :
        - mu
        - sg
      floating      : []
      values        :
        mu :
          - 5240
          - 5220
          - 5280
        sg :
          -  50
          -  20
          - 100
{% endfor %}
fit:
  strategy  :
    pvalue : 0.05
    ntries : 10
plots:
  nbins   : 30
  stacked : True
  d_leg   :
{% for block in range(1, 9) %}
    bpkpee_brem_xx1_b{{ block }} : '$B^+\to K^+e^+e^-$, $1\gamma$, Block {{ block }} (DSCB)'
    bpkpee_brem_xx2_b{{ block }} : '$B^+\to K^+e^+e^-$, $2\gamma$, Block {{ block }} (DSCB)'
{% endfor %}
  plot_range:
    - 4600
    - 6000
